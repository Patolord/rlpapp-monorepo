{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        ".vercel/output/**",
        ".eve/**",
        ".output/**"
      ],
      "env": [
        "CONVEX_SECRET_KEY",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "VITE_CLERK_JWT_ISSUER_DOMAIN",
        "CLERK_JWT_ISSUER_DOMAIN",
        "CLERK_PUBLISHABLE_KEY",
        "UMAMI_WEBSITE_ID",
        "AI_GATEWAY_API_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "REDIS_URL",
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_APP_SECRET",
        "WHATSAPP_PHONE_NUMBER_ID",
        "WHATSAPP_VERIFY_TOKEN",
        "MCP_RESOURCE_URL",
        "MCP_JWT_ISSUER",
        "MCP_JWT_PRIVATE_KEY",
        "MCP_JWT_JWKS",
        "MCP_JWT_KEY_ID",
        "MCP_ALLOWED_HOSTS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:setup": {
      "cache": false,
      "persistent": true
    }
  }
}
