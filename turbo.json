{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".vercel/output/**"],
      "env": [
        "CONVEX_SECRET_KEY",
        "VITE_CONVEX_URL",
        "VITE_CONVEX_SITE_URL",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_CLERK_PROXY_URL",
        "CLERK_SECRET_KEY",
        "VITE_CLERK_JWT_ISSUER_DOMAIN",
        "CLERK_JWT_ISSUER_DOMAIN",
        "CLERK_PUBLISHABLE_KEY",
        "UMAMI_WEBSITE_ID"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:setup": {
      "cache": false,
      "persistent": true
    }
  }
}
