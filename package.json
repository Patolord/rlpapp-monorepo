{
  "name": "rlpapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "pnpm": {
    "overrides": {
      "use-sync-external-store": "^1.4.0"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @rlpapp/backend dev",
    "dev:setup": "turbo -F @rlpapp/backend dev:setup"
  },
  "dependencies": {
    "@rlpapp/env": "workspace:*",
    "@tanstack/react-start": "^1.158.0",
    "dotenv": "catalog:",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rlpapp/config": "workspace:*",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.14.0"
}
