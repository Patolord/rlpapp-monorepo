{
  "name": "rlpapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "pnpm": {
    "overrides": {
      "use-sync-external-store": "^1.4.0"
    },
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "browser-tabs-lock",
      "bufferutil",
      "core-js",
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:web:server": "turbo -F web -F @rlpapp/backend dev",
    "dev:server": "turbo -F @rlpapp/backend dev",
    "dev:setup": "turbo -F @rlpapp/backend dev:setup"
  },
  "dependencies": {
    "@rlpapp/env": "workspace:*",
    "@tanstack/react-start": "^1.167.65",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rlpapp/config": "workspace:*",
    "@types/node": "^25.6.2",
    "turbo": "^2.9.11",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.14.0"
}
