{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Takeoff",
  "version": "0.1.0",
  "identifier": "com.rlp.takeoff",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Takeoff",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "RLP Engenharia e Instalações Ltda.",
    "copyright": "© RLP Engenharia",
    "shortDescription": "Takeoff e orçamento a partir de PDF",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4OUMzRTA4MzE2NDc5NkUKUldSdWVXUXhDRDZjdUZIVzUxaGJyRThsNExsMUtMaVhPNzhMbVRKa0lPbGxqazdDMVFuSythN1YK",
      "endpoints": [
        "https://github.com/Patolord/takeoff-releases/releases/latest/download/latest.json",
        "https://app.rlpeng.com.br/takeoff/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
