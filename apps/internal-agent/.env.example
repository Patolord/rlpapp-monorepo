# Model access — not needed when the app is linked to a Vercel project
# (Vercel OIDC covers the AI Gateway). Set it for plain local dev instead:
# AI_GATEWAY_API_KEY=

# Upstash Redis (one free DB covers both AgentKit and WhatsApp Chat SDK state).
# Create at https://console.upstash.com → Redis → REST API credentials:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Same Upstash DB → Details → "Connect" / Redis URL (rediss://…) for WhatsApp
# Chat SDK subscriptions/locks in production. Optional locally (falls back to
# in-memory state when unset):
# REDIS_URL=

# WhatsApp Business Cloud (Meta app > WhatsApp product).
# Webhook callback URL: https://<deployment>/eve/v1/whatsapp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
