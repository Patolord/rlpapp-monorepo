# Model access — not needed when the app is linked to a Vercel project
# (Vercel OIDC covers the AI Gateway). Set it for plain local dev instead:
# AI_GATEWAY_API_KEY=

# Chat SDK durable state (required in production; optional locally — falls
# back to in-memory state when unset). Use a serverless-friendly Redis such
# as Upstash.
# REDIS_URL=

# WhatsApp Business Cloud (Meta app > WhatsApp product).
# Webhook callback URL: https://<deployment>/eve/v1/whatsapp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
